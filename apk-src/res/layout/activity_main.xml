<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ramadan Mubarak"
            android:textColor="@color/gold"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_text"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Countdown section -->
        <TextView
            android:id="@+id/countdownLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time to Iftar"
            android:textColor="@color/teal"
            android:textSize="18sp"
            android:layout_marginTop="32dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/hoursText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:textColor="@color/warm_white"
                    android:textSize="56sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="h"
                    android:textColor="@color/light_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textColor="@color/gold"
                android:textSize="48sp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/minutesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:textColor="@color/warm_white"
                    android:textSize="56sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="m"
                    android:textColor="@color/light_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textColor="@color/gold"
                android:textSize="48sp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/secondsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:textColor="@color/warm_white"
                    android:textSize="56sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="s"
                    android:textColor="@color/light_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/targetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iftar"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Prayer times header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prayer Times"
            android:textColor="@color/warm_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <!-- Prayer time rows -->
        <include layout="@layout/prayer_row"
            android:id="@+id/rowFajr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/prayer_row"
            android:id="@+id/rowSunrise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/prayer_row"
            android:id="@+id/rowDhuhr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/prayer_row"
            android:id="@+id/rowAsr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/prayer_row"
            android:id="@+id/rowMaghrib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/prayer_row"
            android:id="@+id/rowIsha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Location status -->
        <TextView
            android:id="@+id/locationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_text"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <!-- Calculation method -->
        <TextView
            android:id="@+id/methodText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_text"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
